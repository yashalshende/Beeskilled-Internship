    {
      "name": "1. Health",
      "description": "API Health Check and system runtime status.",
      "item": [
        {
          "name": "Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response indicates API is healthy\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.message).to.include(\"healthy\");",
                  "});",
                  "",
                  "pm.test(\"Database state is Connected\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.database).to.be.an('object');",
                  "    pm.expect(jsonData.database.status).to.eql(\"Connected\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            },
            "description": "Returns status, uptime, environment, and MongoDB connection state."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Authentication",
      "description": "User registration, credential login, JWT token issuance, and protected profile access.",
      "item": [
        {
          "name": "Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created or 400 (Duplicate)\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([201, 400]);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "if (pm.response.code === 201) {",
                  "    pm.test(\"User registered successfully with valid token\", function () {",
                  "        pm.expect(jsonData.success).to.be.true;",
                  "        pm.expect(jsonData.data.token).to.be.a('string');",
                  "        pm.expect(jsonData.data.user.name).to.be.a('string');",
                  "        pm.expect(jsonData.data.user.email).to.be.a('string');",
                  "    });",
                  "    pm.test(\"Password hash is NEVER exposed\", function () {",
                  "        pm.expect(jsonData.data.user.password).to.be.undefined;",
                  "        pm.expect(jsonData.data.password).to.be.undefined;",
                  "    });",
                  "    pm.collectionVariables.set(\"token\", jsonData.data.token);",
                  "    if (pm.environment) { pm.environment.set(\"token\", jsonData.data.token); }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Yashal Shende\",\n  \"email\": \"postman.user@beeskilled.com\",\n  \"password\": \"SecurePassword123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
