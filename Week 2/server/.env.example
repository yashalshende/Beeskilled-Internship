# Server Port
PORT=5000

# Node Environment (development | production | test)
NODE_ENV=development

# MongoDB Connection String
MONGODB_URI=mongodb://127.0.0.1:27017/beeskilled_week2

# JWT Authentication Configuration (Generate a cryptographically random secret with min 32 chars)
JWT_SECRET=replace_with_a_secure_random_256_bit_secret_min_32_chars
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (Comma-separated in production or '*' for open access)
CORS_ORIGIN=*
